---
import Default from '@astrojs/starlight/components/Footer.astro';
import { localeFrom, t } from '~/lib/i18n';

const route = Astro.locals.starlightRoute;
const locale = localeFrom(route.lang);
const verified = route.entry.data.lastVerified as Date | undefined;
const fmt = verified
  ? new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeZone: 'UTC' }).format(verified)
  : undefined;
---
<Default><slot /></Default>
<div class="bcc-footer">
  {fmt && <p>{t(locale, 'lastVerified')} <time datetime={verified!.toISOString().slice(0, 10)}>{fmt}</time>.</p>}
  <p>{t(locale, 'footer.community')}</p>
</div>
<style>
  .bcc-footer {
    margin-top: 1.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .bcc-footer p { margin: 0.25rem 0; }
</style>
