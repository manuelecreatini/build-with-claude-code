---
import { localeFrom, t } from '~/lib/i18n';

interface Props {
  title?: string;
}
const locale = localeFrom(Astro.currentLocale);
const { title = t(locale, 'hood.summary') } = Astro.props;
---
<details class="bcc-hood">
  <summary>
    <svg class="bcc-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 7-5 5 5 5M16 7l5 5-5 5" /></svg>
    <span>{title}</span>
  </summary>
  <slot />
</details>
