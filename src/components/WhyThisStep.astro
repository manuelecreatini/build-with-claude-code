---
import { localeFrom, t } from '~/lib/i18n';
const locale = localeFrom(Astro.currentLocale);
---
<div class="bcc-why">
  <svg class="bcc-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v4h1" /></svg>
  <p><strong class="bcc-why__label">{t(locale, 'why.label')}<span class="bcc-sr">:</span></strong> <slot /></p>
</div>
