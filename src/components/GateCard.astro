---
import { localeFrom, t } from '~/lib/i18n';

interface Props {
  n: number;
  title?: string;
}
const { n, title } = Astro.props;
const locale = localeFrom(Astro.currentLocale);
---
<aside class="bcc-gate" aria-label={`${t(locale, 'gate.heading')} G${n}`}>
  <p class="bcc-gate__head">
    <svg class="bcc-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
    <strong>{t(locale, 'gate.heading')} G{n}{title ? ` · ${title}` : ''}</strong>
  </p>
  <slot />
</aside>
